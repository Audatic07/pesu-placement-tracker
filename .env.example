# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# ---------------------------------------------------------------------------

# Postgres. Matches docker-compose.yml (host port 5433 to avoid clashing with a
# local Postgres on 5432). In production point this at Neon/Supabase.
DATABASE_URL="postgresql://placement:placement_dev_only@localhost:5433/placement_tracker?schema=public"

# The same database, WITHOUT the connection pooler. Leave it unset locally —
# there is no pooler in docker-compose, so DATABASE_URL is already direct.
#
# Set it in production. A serverless host needs the pooled URL above, because
# every function instance opens its own connections; but a transaction-mode
# pooler does not carry the advisory locks Prisma takes during a migration, so
# `prisma migrate deploy` against it hangs or fails. Migrations read this.
# DIRECT_DATABASE_URL=""

# Signs our own session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every active session, which is the intended
# emergency response to a suspected leak.
SESSION_SECRET=""

# PESU authentication service (https://github.com/pesu-dev/auth).
#
# Runs locally, from docker-compose.yml. The hosted instance at
# https://pesu-auth.onrender.com works, but sits behind a free-tier gateway that
# returns 502 on slow requests — and the only slow request is a SUCCESSFUL
# login, since that is the one that goes on to scrape a profile. The practical
# effect was that correct passwords failed and wrong ones were rejected cleanly.
#
# Point this at the hosted instance if you would rather not run the container;
# the client retries gateway errors either way.
PESU_AUTH_BASE_URL="http://localhost:5000"

# Two attempts at up to 25 seconds each, with a one-second retry delay.
# The timeout also covers reading the response body.
PESU_AUTH_TIMEOUT_MS="25000"

# SRN of the first SUPER_ADMIN. Seeding grants this SRN full admin rights on
# first login; the account itself is only created when they actually log in.
SUPER_ADMIN_SRN=""

# Minimum cohort size for any public aggregate. Below this, statistics are
# suppressed rather than shown. Lowering this weakens student anonymity.
PRIVACY_MIN_COHORT_SIZE="5"

# Historical workbooks are read offline. Hand-prepared offers use the same
# Offer records as student submissions; no spreadsheet paths are needed here.
